# ─────────────────────────────────────────────────────────────────────────────
# ServeConnect server configuration
# Run `npm run setup` to copy this file to .env and auto-generate every secret.
# Everything marked OPTIONAL works without a value in local development.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
APP_NAME=ServeConnect
# Public URL of the web app (emails, QR codes and certificate links point here)
APP_URL=http://localhost:5173
# Public URL of this API (used to build links to uploaded files with the local storage driver)
PUBLIC_API_URL=http://localhost:4000
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# ── Database (PostgreSQL 14+) ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/serveconnect
# Set true for hosted databases that require SSL (Neon, Supabase, Render)
DATABASE_SSL=false

# ── Secrets (auto-generated by `npm run setup`; never commit real values) ──
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 64 hex chars — AES-256-GCM key for blood group, phone, 2FA secrets and verification documents
ENCRYPTION_KEY=
# 64 hex chars — HMAC key for blind indexes (lookup of encrypted values)
BLIND_INDEX_KEY=
QR_SECRET=

# ── Sessions ──
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# Sign the user out after this many days without activity
SESSION_IDLE_DAYS=7
# lax when the web app and API share a domain; none (+COOKIE_SECURE=true) when on different domains
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Google Sign-In (OPTIONAL) — https://console.cloud.google.com/apis/credentials ──
GOOGLE_CLIENT_ID=

# ── Email (OPTIONAL in dev: emails are printed to the console) ──
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + an App Password
# Brevo (300/day free): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ServeConnect <no-reply@serveconnect.local>

# ── SMS OTP (OPTIONAL in dev: codes are printed to the console) ──
# console | twilio | fast2sms
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAST2SMS_API_KEY=
DEFAULT_COUNTRY_CODE=+91

# ── Media storage ──
# local (files in ./uploads) | cloudinary (recommended in production; free tier)
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ── Virus scanning (OPTIONAL) — point at a clamd daemon, e.g. docker run -p 3310:3310 clamav/clamav ──
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Web Push (VAPID keys auto-generated by `npm run setup`) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Free external APIs (no keys needed) ──
NOMINATIM_URL=https://nominatim.openstreetmap.org
WEATHER_URL=https://api.open-meteo.com/v1/forecast

# ── Misc ──
# Days to keep verification documents after a decision
DOC_RETENTION_DAYS=90
# Run background jobs in this process (disable on extra instances if you like; jobs are lock-protected anyway)
RUN_JOBS=true
# Serve the built web app from ../client/dist (single-service deployment)
SERVE_CLIENT=true
# Development only: return OTP codes in API responses so you can test without email/SMS. Forced off in production.
DEV_EXPOSE_OTP=true
