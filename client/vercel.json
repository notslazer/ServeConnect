{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND.onrender.com/api/:path*" },
    { "source": "/socket.io/:path*", "destination": "https://YOUR-BACKEND.onrender.com/socket.io/:path*" },
    { "source": "/uploads/:path*", "destination": "https://YOUR-BACKEND.onrender.com/uploads/:path*" },
    { "source": "/((?!assets/|icons/|sw.js|manifest.webmanifest).*)", "destination": "/index.html" }
  ]
}
